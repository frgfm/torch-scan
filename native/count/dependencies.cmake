file(READ "${CMAKE_CURRENT_LIST_DIR}/dependencies.json" DEPENDENCIES)
set(TORCHSCAN_DEPS_CACHE "$ENV{TORCHSCAN_DEPS_CACHE}" CACHE PATH "Verified upstream source cache")
if(NOT TORCHSCAN_DEPS_CACHE)
  set(TORCHSCAN_DEPS_CACHE "${CMAKE_CURRENT_BINARY_DIR}/downloads")
endif()
file(MAKE_DIRECTORY "${TORCHSCAN_DEPS_CACHE}")
foreach(DEPENDENCY boost json)
  string(JSON FILENAME GET "${DEPENDENCIES}" ${DEPENDENCY} filename)
  string(JSON URL GET "${DEPENDENCIES}" ${DEPENDENCY} url)
  string(JSON SHA256 GET "${DEPENDENCIES}" ${DEPENDENCY} sha256)
  set(SOURCE "${TORCHSCAN_DEPS_CACHE}/${FILENAME}")
  if(NOT EXISTS "${SOURCE}")
    file(DOWNLOAD "${URL}" "${SOURCE}" TLS_VERIFY ON EXPECTED_HASH "SHA256=${SHA256}" STATUS RESULT)
    list(GET RESULT 0 STATUS)
    if(NOT STATUS EQUAL 0)
      message(FATAL_ERROR "Cannot download ${FILENAME}: ${RESULT}")
    endif()
  endif()
  file(SHA256 "${SOURCE}" ACTUAL_SHA256)
  if(NOT ACTUAL_SHA256 STREQUAL SHA256)
    message(FATAL_ERROR "SHA-256 mismatch for ${FILENAME}; refusing to use cached headers")
  endif()
  set(${DEPENDENCY}_SOURCE "${SOURCE}")
endforeach()
string(JSON BOOST_PREFIX GET "${DEPENDENCIES}" boost prefix)
set(HEADERS "${CMAKE_CURRENT_BINARY_DIR}/headers")
file(ARCHIVE_EXTRACT INPUT "${boost_SOURCE}" DESTINATION "${HEADERS}" PATTERNS "${BOOST_PREFIX}*")
string(REGEX REPLACE "/boost/$" "" BOOST_ROOT "${BOOST_PREFIX}")
set(INCLUDE_DIR "${HEADERS}/${BOOST_ROOT}")
file(MAKE_DIRECTORY "${INCLUDE_DIR}/nlohmann")
configure_file("${json_SOURCE}" "${INCLUDE_DIR}/nlohmann/json.hpp" COPYONLY)
